      window.GameStart = window.GameStart || function(){};
      window.GameStop = window.GameStop || function(){};
      var userData = "";
      window.triggerSignIn = function(){};
      window.saveGameData = function(v){ userData = v; };
      window.loadGameData = function(){ return userData; };
      window.loadGameDataAsync = function(){ if (typeof Main !== 'undefined' && Main.LoadDataComplete) Main.LoadDataComplete(); };
      window.signOut = function(){ if (typeof Main !== 'undefined' && Main.SignOutComplete) Main.SignOutComplete(); };
      window.isUserLoggedIn = function(){ return false; };
    })();
  </script>
