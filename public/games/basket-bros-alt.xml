      function safe(fn){ try{ fn && fn(); }catch(e){} }
      function doneInterstitial(){ if (window.Main && typeof Main.DoneInterstitialAd === 'function') Main.DoneInterstitialAd(false); }
      function doneRewarded(){ if (window.Main && typeof Main.DoneVideoAd === 'function') Main.DoneVideoAd(); }
      window.ShowAdBreak = function(){ safe(doneInterstitial); };
      window.ShowVideo = function(){ safe(doneRewarded); };
      window.ShowAd = function(){ safe(doneInterstitial); };
      window.ShowInterstitial = function(){ safe(doneInterstitial); };
      window.ShowRewarded = function(){ safe(doneRewarded); };
      for (var i=1;i<=10;i++){
        window['ShowAd'+i] = function(){ safe(doneInterstitial); };
        window['ShowVideo'+i] = function(){ safe(doneRewarded); };
      }
      window.adBreak = function(opts){ safe(opts && opts.before); safe(opts && opts.after); return Promise.resolve(); };
      window.rewardedBreak = function(opts){ safe(opts && opts.before); safe(opts && opts.after); return Promise.resolve({completed:false}); };
      window.PauseGame = window.PauseGame || function(){};
      window.ResumeGame = window.ResumeGame || function(){};
      window.GamePlayStart = window.GamePlayStart || function(){};
      window.GamePlayStop = window.GamePlayStop || function(){};
