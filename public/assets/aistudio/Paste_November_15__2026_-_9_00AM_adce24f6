    // Butona olay dinleyicisi ekle
    document.addEventListener('DOMContentLoaded', function() {
      const playButton = document.getElementById('playButton');
      const fullscreenButton = document.getElementById('fullscreenButton');
      
      if (playButton) {
        playButton.addEventListener('click', showContent);
      } else {
        console.error('Play butonu bulunamadı.');
      }
      
      if (fullscreenButton) {
        fullscreenButton.addEventListener('click', openFullscreen);
      } else {
        console.error('Fullscreen butonu bulunamadı.');
      }
    });

    function showContent() {
      try {
        // Sadece play butonunu gizle
        document.getElementById('playButton').style.display = 'none';
        
        // İçerik konteynırını göster
        const container = document.getElementById('contentContainer');
        container.style.display = 'block';

        // Blob oluştur
        const blob = new Blob([gameHTML], { type: 'text/html' });
        const blobUrl = URL.createObjectURL(blob);

        // Mevcut iframe varsa temizle
        while (container.firstChild) {
          container.removeChild(container.firstChild);
        }

        // Yeni iframe oluştur
        const iframe = document.createElement('iframe');
        iframe.src = blobUrl;
        iframe.style.width = '100%';
        iframe.style.height = '100%';
        iframe.style.border = 'none';
        iframe.style.margin = '0';
        iframe.style.padding = '0';

        // Iframe'i ekle
        container.appendChild(iframe);

        // Hata ayıklama
        iframe.onload = () => console.log('Oyun yüklendi');
        iframe.onerror = (e) => console.error('Oyun yüklenirken hata:', e);
      } catch (error) {
        console.error('Hata oluştu:', error);
        alert('Oyun yüklenemedi. Tarayıcı konsolunu kontrol edin.');
      }
    }

    function openFullscreen() {
      try {
        // Yeni sekme aç
        const newWin = window.open("about:blank", "_blank");
        if (newWin) {
          newWin.document.open();
          newWin.document.write(gameHTML);
          newWin.document.close();

          // Tam ekran modunu ayarla (isteğe bağlı, tarayıcıya bağlı olarak çalışmayabilir)
          setTimeout(() => {
            if (newWin.document.documentElement.requestFullscreen) {
              newWin.document.documentElement.requestFullscreen();
            } else if (newWin.document.documentElement.mozRequestFullScreen) {
              newWin.document.documentElement.mozRequestFullScreen();
            } else if (newWin.document.documentElement.webkitRequestFullscreen) {
              newWin.document.documentElement.webkitRequestFullscreen();
            } else if (newWin.document.documentElement.msRequestFullscreen) {
              newWin.document.documentElement.msRequestFullscreen();
            }
          }, 500);
        } else {
          alert("Yeni sekme açma engellendi. Lütfen tarayıcı ayarlarını kontrol edin.");
        }
      } catch (error) {
        console.error('Fullscreen hata:', error);
        alert('Tam ekran modu çalışmadı. Tarayıcı konsolunu kontrol edin.');
      }
    }
  </script>


      <script>
        (function() {
          // The root element's background fills the whole page. As in CSS,
          // the body's background is used when the root element has none.
          function getPageBackgroundColor() {
            var docStyle = window.getComputedStyle(document.documentElement);
            var color = docStyle.backgroundColor;
            if ((color === 'rgba(0, 0, 0, 0)' || color === 'transparent') &&
                docStyle.backgroundImage === 'none' && document.body) {
              color = window.getComputedStyle(document.body).backgroundColor;
            }
            return color || '';
          }

          var lastReportedColor = '';
          function reportBackgroundColor() {
            try {
              var color = getPageBackgroundColor();
              if (color === lastReportedColor) return;
              lastReportedColor = color;
              window.parent.postMessage({
                type: 'ATARI_CODE_EMBED_BACKGROUND_COLOR',
                backgroundColor: color
              }, '*');
            } catch (e) {}
          }

          // The page background usually changes through an attribute on html
          // or body (for example a theme class), a style sheet in head, or the
          // system color scheme.
          if (typeof MutationObserver !== 'undefined') {
            var observer = new MutationObserver(reportBackgroundColor);
            observer.observe(document.documentElement, {attributes: true});
            if (document.body) {
              observer.observe(document.body, {attributes: true});
            }
            if (document.head) {
              observer.observe(document.head, {
                attributes: true,
                childList: true,
                subtree: true,
                characterData: true
              });
            }
          }
          var colorSchemeQuery =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
          if (colorSchemeQuery && colorSchemeQuery.addEventListener) {
            colorSchemeQuery.addEventListener('change', reportBackgroundColor);
          }
          window.addEventListener('load', reportBackgroundColor);
          window.addEventListener('transitionend', reportBackgroundColor);
          window.addEventListener('animationend', reportBackgroundColor);
          reportBackgroundColor();
        })();
